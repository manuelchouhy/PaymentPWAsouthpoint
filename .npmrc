# El proyecto corre vite 8, pero dos plugins declaran rangos de peer viejos:
#   @vitejs/plugin-react@4.7.0  -> vite ^4 || ^5 || ^6 || ^7
#   vite-plugin-pwa@0.21.2      -> vite ^3 || ^4 || ^5 || ^6
#
# Es metadata desactualizada, no incompatibilidad real: el build funciona y la
# app corre. Pero npm valida los peers en instalación limpia, así que sin esto
# `npm install` falla con ERESOLVE en cualquier clone nuevo y en el build de
# Vercel. El node_modules local ya estaba armado así; esto sólo lo hace
# explícito y reproducible.
#
# SALIDA PREVISTA: subir los dos plugins a versiones que declaren vite 8 y
# borrar este archivo.
#   @vitejs/plugin-react  4.7.0  -> 5.2.0  (peer vite ^4||^5||^6||^7||^8)
#   vite-plugin-pwa       0.21.2 -> 1.3.0  (peer vite ^3..^8)
# El salto de vite-plugin-pwa es mayor y toca la generación del service worker,
# así que va en su propio slice con verificación del output de PWA.
legacy-peer-deps=true
