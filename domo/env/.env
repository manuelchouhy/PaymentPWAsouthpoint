# Entorno de build para el bundle de DOMO (vite.config.domo.js lo carga vía envDir).
# Esta carpeta NO contiene .env.local a propósito: así el build de DOMO nunca
# hereda las credenciales reales de Supabase ni el admin de test.
#
# VITE_FORCE_MOCK fuerza isSupabaseConfigured=false → login salteado (DEMO_USER)
# + todas las páginas con datos mock + cero llamadas de datos a un backend.
VITE_FORCE_MOCK=true

# Explícitamente vacías: la app corre 100% mock, sin backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_MODE=supabase
