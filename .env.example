# Copiá este archivo a `.env.local` y completá con las credenciales del
# proyecto de Supabase. Si las dejás vacías, la app corre en modo demo con
# datos mock (no escribe nada en ningún lado).
#
# Las dos variables se obtienen en:
#   Supabase Dashboard → tu proyecto → Project Settings → API
#     - VITE_SUPABASE_URL       → "Project URL"
#     - VITE_SUPABASE_ANON_KEY  → "anon public" key
#
# Importante: la anon key viaja embebida en el bundle del cliente. Configurá
# Row Level Security en Supabase (ver supabase/schema.sql) antes de exponer
# la app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
